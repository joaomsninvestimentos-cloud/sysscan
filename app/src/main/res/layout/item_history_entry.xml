<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_item_card"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="@dimen/space_medium"
    tools:context=".history.HistoryActivity">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/historyDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="24/08 às 14:00" />

        <TextView
            android:id="@+id/historyDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/gray_text"
            android:textSize="13sp"
            tools:text="OK 20 · 2 atenção · 1 crítico · root" />
    </LinearLayout>

    <TextView
        android:id="@+id/historyScore"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/ok_green"
        android:textSize="28sp"
        android:textStyle="bold"
        tools:text="92" />
</LinearLayout>
