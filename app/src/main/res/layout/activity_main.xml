<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/sysscan_primary_light"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/sysscan_primary_dark"
        android:paddingStart="@dimen/space_large"
        android:paddingEnd="8dp"
        android:paddingTop="28dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textColor="@color/white"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/scan_subtitle"
                    android:textColor="#C8E6D9"
                    android:textSize="14sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnUpdate"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_download"
                android:contentDescription="@string/update_check"
                app:tint="@color/white" />

            <ImageButton
                android:id="@+id/btnDarkToggle"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_dark_mode"
                android:contentDescription="@string/toggle_dark"
                app:tint="@color/white" />

            <ImageButton
                android:id="@+id/btnHistory"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_history"
                android:contentDescription="@string/history_open"
                app:tint="@color/white" />

            <ImageButton
                android:id="@+id/btnChat"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_chat"
                android:contentDescription="@string/chat_open"
                app:tint="@color/white" />
        </LinearLayout>
    </LinearLayout>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/scoreCard"
        style="@style/Widget.Material3.CardView.Elevated"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/space_medium"
        app:cardBackgroundColor="@color/card_bg"
        app:cardCornerRadius="@dimen/card_radius"
        app:cardElevation="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:padding="@dimen/space_large">

            <FrameLayout
                android:layout_width="@dimen/score_circle_size"
                android:layout_height="@dimen/score_circle_size">

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/scoreIndicator"
                    android:layout_width="@dimen/score_circle_size"
                    android:layout_height="@dimen/score_circle_size"
                    android:layout_gravity="center"
                    app:indicatorColor="@color/score_circle_ok"
                    app:indicatorSize="@dimen/score_circle_size"
                    app:trackColor="@color/sysscan_primary_light"
                    app:trackThickness="12dp" />

                <TextView
                    android:id="@+id/scoreValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="—"
                    android:textColor="@color/text_primary"
                    android:textSize="44sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <TextView
                android:id="@+id/scoreLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_small"
                    android:text="@string/health_score"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/scoreSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_small"
                android:gravity="center"
                android:text=""
                android:textColor="@color/gray_text"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnScan"
                style="@style/Widget.Material3.Button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_medium"
                android:text="@string/scan_start"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/btnFixAll"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/fix_all"
                android:textAllCaps="false"
                android:visibility="gone" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/rootCard"
        style="@style/Widget.Material3.CardView.Elevated"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_medium"
        android:layout_marginEnd="@dimen/space_medium"
        android:layout_marginBottom="@dimen/space_small"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"
        app:cardBackgroundColor="@color/card_bg"
        app:cardCornerRadius="@dimen/card_radius"
        app:cardElevation="2dp"
        app:rippleColor="@color/sysscan_primary">

        <LinearLayout
            android:id="@+id/rootRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="@dimen/space_medium"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/root_status_label"
                android:textColor="@color/gray_text"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/rootStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="—"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <LinearLayout
        android:id="@+id/progressCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_medium"
        android:layout_marginEnd="@dimen/space_medium"
        android:layout_marginBottom="@dimen/space_small"
        android:orientation="vertical"
        android:padding="@dimen/space_medium"
        android:background="@color/card_bg"
        android:visibility="gone">

        <TextView
            android:id="@+id/progressLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/scan_in_progress"
            android:textColor="@color/gray_text"
            android:textSize="13sp" />

        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_small"
            android:max="100"
            android:progressTint="@color/sysscan_primary" />
    </LinearLayout>

    <Button
        android:id="@+id/btnUpdateBanner"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_medium"
        android:layout_marginEnd="@dimen/space_medium"
        android:layout_marginBottom="@dimen/space_small"
        android:text="@string/update_available"
        android:textAllCaps="false"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/summaryRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_medium"
        android:layout_marginEnd="@dimen/space_medium"
        android:layout_marginBottom="@dimen/space_small"
        android:orientation="horizontal"
        android:visibility="gone">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/okCount"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minHeight="48dp"
            android:textAllCaps="false"
            android:textColor="@color/ok_green"
            android:textStyle="bold"
            android:textSize="13sp"
            app:backgroundTint="@color/ok_green_bg"
            app:cornerRadius="20dp"
            app:rippleColor="@color/ok_green"
            tools:text="0 OK" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/warnCount"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minHeight="48dp"
            android:textAllCaps="false"
            android:textColor="@color/warn_amber"
            android:textStyle="bold"
            android:textSize="13sp"
            app:backgroundTint="@color/warn_amber_bg"
            app:cornerRadius="20dp"
            app:rippleColor="@color/warn_amber"
            tools:text="0 Atenção" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/critCount"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minHeight="48dp"
            android:textAllCaps="false"
            android:textColor="@color/crit_red"
            android:textStyle="bold"
            android:textSize="13sp"
            app:backgroundTint="@color/crit_red_bg"
            app:cornerRadius="20dp"
            app:rippleColor="@color/crit_red"
            tools:text="0 Crítico" />

        <Button
            android:id="@+id/btnFilterClear"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_pill_clear"
            android:minHeight="48dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="@string/filter_clear"
            android:textAllCaps="false"
            android:textColor="@color/gray_text"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:text="Limpar" />
    </LinearLayout>

    <TextView
        android:id="@+id/emptyFilterText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_medium"
        android:layout_marginEnd="@dimen/space_medium"
        android:layout_marginBottom="@dimen/space_medium"
        android:gravity="center"
        android:padding="@dimen/space_large"
        android:background="@color/card_bg"
        android:text="@string/filter_empty"
        android:textColor="@color/gray_text"
        android:textSize="14sp"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/resultsList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingStart="@dimen/space_medium"
        android:paddingEnd="@dimen/space_medium"
        android:paddingBottom="@dimen/space_medium"
        tools:listitem="@layout/item_scan_check" />

</LinearLayout>
