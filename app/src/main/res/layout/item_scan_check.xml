<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_item_card"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="@dimen/space_medium"
    tools:context=".MainActivity">

    <ImageView
        android:id="@+id/severityIcon"
        android:layout_width="@dimen/item_icon_size"
        android:layout_height="@dimen/item_icon_size"
        android:background="@drawable/bg_severity_circle"
        android:padding="8dp"
        android:contentDescription="@null"
        app:tint="@color/white"
        tools:src="@drawable/ic_check_circle" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="12dp">

        <TextView
            android:id="@+id/checkTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="Título da verificação" />

        <TextView
            android:id="@+id/checkDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/gray_text"
            android:textSize="13sp"
            tools:text="Detalhe da verificação com informações relevantes." />
    </LinearLayout>

    <Button
        android:id="@+id/btnFix"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:text="@string/results_fix"
        android:textAllCaps="false"
        android:textSize="12sp"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/fixedIcon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginStart="8dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_check_circle"
        android:visibility="gone"
        app:tint="@color/ok_green" />
</LinearLayout>
